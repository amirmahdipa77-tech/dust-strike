{
  "name": "dust-strike",
  "private": true,
  "version": "7.0.0",
  "type": "module",
  "description": "Dust Strike - a light, smooth CS-style mobile FPS built with TypeScript + Three.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync:android": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
